<!DOCTYPE html>
<html>
<head>
  <title>Administrador</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

<h2>Administrador</h2>
<a href="/">Volver a galería</a>
<a href="/logout">Cerrar sesión</a>

<table>
  <tr>
    <th>Nombre</th>
    <th>Descripción</th>
    <th>Precio</th>
    <th>Categoría</th>
    <th>Imagen ID</th>
  </tr>

  <% items.forEach((item, i) => { %>
    <tr>
      <td><input value="<%= item.Nombre %>" class="input" data-row="<%= i %>" data-col="Nombre"></td>
      <td><input value="<%= item.Descripción %>" class="input" data-row="<%= i %>" data-col="Descripción"></td>
      <td><input value="<%= item.Precio %>" class="input" data-row="<%= i %>" data-col="Precio"></td>
      <td>
        <select class="input" data-row="<%= i %>" data-col="Categoria">
          <% categories.forEach(cat => { %>
            <option <%= item.Categoria === cat ? "selected" : "" %>><%= cat %></option>
          <% }) %>
        </select>
      </td>
      <td><input value="<%= item.ImagenID %>" class="input" data-row="<%= i %>" data-col="ImagenID"></td>
    </tr>
  <% }) %>
</table>

<button onclick="save()">Guardar</button>

<script src="/script.js"></script>

</body>
</html>
