<!DOCTYPE html>
<html>
<head>
  <title>Catálogo</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

<h1>Catálogo</h1>
<a href="/login">Admin</a>

<select id="filter" onchange="filterCategory()">
  <option value="TODOS">Todos</option>
  <% categories.forEach(cat => { %>
    <option><%= cat %></option>
  <% }) %>
</select>

<div id="gallery">
  <% items.forEach(item => { %>
    <div class="card" data-cat="<%= item.Categoria %>">
      <img src="<%= item.ImagenURL %>">
      <h3><%= item.Nombre %></h3>
      <p><%= item.Descripción %></p>
      <strong>$<%= item.Precio %></strong>
    </div>
  <% }) %>
</div>

<script>
function filterCategory() {
  let cat = document.getElementById("filter").value;
  document.querySelectorAll(".card").forEach(card => {
    card.style.display = (cat === "TODOS" || card.dataset.cat === cat)
      ? "block" : "none";
  });
}
</script>

</body>
</html>
